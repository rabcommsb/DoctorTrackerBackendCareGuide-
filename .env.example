# Server Port (Local Development)
PORT=3000

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/doctor-tracker?retryWrites=true&w=majority

# Stateless JWT Configuration (RFC 7519 HS256)
# Generate a 256-bit secret via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m

# Frontend Origin for CORS (no trailing slash, e.g. https://your-frontend.vercel.app)
CLIENT_URL=http://localhost:5173
