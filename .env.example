# Server Configuration
PORT=3000

# MongoDB Connection URI
# When omitted in preview, falls back to an in-memory MongoDB instance.
MONGODB_URI=mongodb://localhost:27017/doctor-tracker

# Stateless JWT Authentication (RFC 7519)
# Generate a 256-bit (32-byte) high-entropy secret using Node.js native crypto:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Or via OpenSSL:
# openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# Short-lived Access Token (15 minutes = 900 seconds) & Refresh Token lifespan
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Client Origin
CLIENT_URL=http://localhost:3000

# AI Studio Runtime Variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
