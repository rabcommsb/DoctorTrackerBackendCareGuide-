JWT_SECRET=7f3a9c2e1b8d4f6a0c5e9d2b3f1a8c7e6d4b9a2f5c8e1d3b0a7f6c4e2d9b8a1f
JWT_EXPIRES_IN=15m

# Frontend Origin for CORS (no trailing slash)
CLIENT_URL=https://doctor-tracker-frontend-care-guide.vercel.app
